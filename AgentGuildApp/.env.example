# ════════════════════════════════════════════════════════════════════════════
# Agent Guild Core — Environment Variables
# ════════════════════════════════════════════════════════════════════════════
#
# REQUIRED variables must be set for the app to start.
# OPTIONAL variables enable specific features but are not required.
#
# Copy this file to .env.local and fill in your values.
# ════════════════════════════════════════════════════════════════════════════


# ── REQUIRED: Firebase ──────────────────────────────────────────────────────
# Create a project at https://console.firebase.google.com and copy your config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── REQUIRED: WalletConnect / Reown (wallet auth) ───────────────────────────
# Free project ID at https://cloud.reown.com (add your domain to the allowlist)
NEXT_PUBLIC_REOWN_PROJECT_ID=
# Wallet adapter to use (see src/lib/wallet/adapters). Default: walletconnect
# NEXT_PUBLIC_WALLET_PROVIDER=walletconnect

# ── REQUIRED: Session secrets ───────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=
PLATFORM_ADMIN_SECRET=
INTERNAL_SERVICE_SECRET=

# ── REQUIRED: Admin wallet (your Web3 address) ──────────────────────────────
NEXT_PUBLIC_ADMIN_ADDRESS=
PLATFORM_ADMIN_WALLETS=
# Client-side copy — admin pages are "use client", and Next.js only inlines
# NEXT_PUBLIC_-prefixed vars into client bundles. Keep this in sync with PLATFORM_ADMIN_WALLETS.
NEXT_PUBLIC_PLATFORM_ADMIN_WALLETS=

# ── App URLs ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_DOMAIN=localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000


# ════════════════════════════════════════════════════════════════════════════
# OPTIONAL — Enable as needed
# ════════════════════════════════════════════════════════════════════════════

# ── Rate limiting (Upstash Redis) ───────────────────────────────────────────
# Without this, rate limits run in-memory (won't survive restarts, and won't
# be shared across serverless instances). Applied to all mutating /api/v1/*
# requests (POST/PUT/PATCH/DELETE) in src/middleware.ts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
API_V1_RATE_LIMIT_MAX=30
API_V1_RATE_LIMIT_WINDOW=10 s

# ── Compute providers (pick the one you want to use) ────────────────────────
# E2B — cloud desktop sandboxes (https://e2b.dev)
E2B_API_KEY=

# AWS EC2
AWS_REGION=us-east-1
AWS_INSTANCE_PROFILE=
# (Uses default AWS credentials chain — IAM role, ~/.aws/credentials, or env)

# Azure
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_RESOURCE_GROUP=

# Google Cloud
GCP_PROJECT_ID=
GCP_ZONE=us-central1-a

# ── OpenClaw workspace integration (optional) ───────────────────────────────
OPENCLAW_DIR=~/.openclaw
OPENCLAW_AGENT=main
WORKSPACE_DIR=

# ── Stripe (marketplace payments) ───────────────────────────────────────────
STRIPE_SECRET_KEY=

# ── AI providers (for agent personas) ───────────────────────────────────────
# Configure any one; the model router picks the first available.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# Optional: pin wallets to the top of the connect modal (comma-separated WalletConnect
# Explorer IDs from https://walletguide.walletconnect.network — e.g. Tangem's).
NEXT_PUBLIC_FEATURED_WALLET_IDS=

# ── Settlement (job payouts — see src/lib/settlement) ───────────────────────
# Signs settlement transactions on base/baseSepolia/sepolia/tempo/solana.
PLATFORM_SETTLEMENT_KEY=

# Tempo only (src/lib/settlement/tempo-adapter.ts) — Tempo pays gas in any
# stablecoin instead of a native token, and supports third-party fee
# sponsorship. All optional; without them the settlement wallet pays its own
# fees in TEMPO_USDC_ADDRESS.
# TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
# TEMPO_USDC_ADDRESS=           # the Tempo Payouts mod only needs this: owners pay from their own wallets
# TEMPO_FEE_TOKEN=              # defaults to TEMPO_USDC_ADDRESS
# TEMPO_FEE_PAYER_KEY=          # self-hosted sponsor account (pays gas for PLATFORM_SETTLEMENT_KEY's txs)
# TEMPO_FEE_PAYER_URL=          # or use a relay service, e.g. https://sponsor.moderato.tempo.xyz (testnet, no key required)

# Machine Payments Protocol (mods/tempo-settlement's GET /paid/ping) — Stripe/
# Tempo's HTTP 402 pay-per-request standard. Requires an account at
# https://mpp.dev to get a secret key; without it, /paid/ping returns 501.
# MPP_SECRET_KEY=               # at least 32 bytes
# TEMPO_MPP_RECIPIENT=          # wallet that receives paid-ping charges; defaults to TEMPO_TREASURY_ADDRESS

# Agent wallets (lib/agent-wallets.ts) — custodial Solana keypairs the
# platform generates and holds on behalf of an agent (its private key never
# leaves the server). Required before any "Generate Wallet" call in the
# agent profile's Wallets card will succeed. Generate with e.g.
# `openssl rand -hex 32`. Back it up like any other secret.
#
# Versioned: this is key version 1. To rotate, ADD AGENT_WALLET_ENCRYPTION_KEY_V2
# (new wallets encrypt under it immediately) without removing this one — old
# wallets still need it to decrypt. Then call
# POST /api/admin/agent-wallets/rotate-key (platform admin) to re-encrypt
# every existing wallet onto V2, and only once its response reports
# staleRemaining: 0 is it safe to remove this var. Removing a key version
# before rotation completes permanently bricks any wallet still on it.
# AGENT_WALLET_ENCRYPTION_KEY=
# AGENT_WALLET_ENCRYPTION_KEY_V2=

# ── Hyperliquid trading (mods/hyperliquid-trading) ──────────────────────────
# Which Hyperliquid Info API this app reads prices/positions/account data
# from — must match the network the GatewayAgent worker actually trades on
# (see GatewayAgent/.env.example), or the UI will show the wrong market.
# "testnet" (default) or "mainnet".
# HYPERLIQUID_NETWORK=testnet

# ── Lending marketplace treasury (src/lib/solana/lending-verify.ts) ─────────
# Public address of a Solana wallet a platform admin personally controls
# outside this app — this app never holds its secret key. Pool deposits,
# solo-loan funding, and treasury-bound repayments are verified on-chain
# against this address; GET /api/v1/lending/treasury throws (and the deposit
# dialog silently hangs on "Continue") until this is set. Withdrawals must be
# paid out manually by whoever holds the keypair.
# SOLANA_LENDING_TREASURY_ADDRESS=
# Cluster lending verifies against: "devnet" (default) or "mainnet-beta".
# On mainnet-beta, SOLANA_USDC_MINT and SOLANA_RPC_URL are REQUIRED — the
# devnet fallbacks below are refused, and lending calls throw until they're
# set (mainnet USDC mint: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v).
# SOLANA_CLUSTER=devnet
# NEXT_PUBLIC_SOLANA_CLUSTER=devnet   # set to match SOLANA_CLUSTER — drives UI labels only
# Devnet USDC-Dev mint and RPC used for verifying those transfers — both
# have devnet-only fallbacks in code.
# SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# SOLANA_RPC_URL=https://api.devnet.solana.com
# Devnet only: pool deposits may also be paid in native SOL, credited at this
# fixed SOL→USD test rate (default 150). Ignored on mainnet-beta, where SOL
# deposits are refused.
# LENDING_DEVNET_SOL_USD=150
# For mainnet, use a multisig vault (e.g. a Squads vault address) as
# SOLANA_LENDING_TREASURY_ADDRESS rather than a single person's wallet — the
# verifier only checks the owner address, so a multisig vault works unchanged.

# ── Lending launch guards (src/lib/lending/config.ts) ───────────────────────
# All optional; unset = unlimited. Repayments are never blocked.
# LENDING_PAUSED=false                      # true = no new deposits, loans or offers
# LENDING_ALLOWLIST=                        # comma-separated wallets; set = closed beta
# LENDING_MAX_POOL_TVL_USD=                 # cap on a pool's total value
# LENDING_MAX_DEPOSIT_PER_WALLET_USD=       # cap on one wallet's net deposits per pool
# LENDING_MAX_LOAN_USD=                     # cap on any single loan / offer
# LENDING_DEFAULT_GRACE_DAYS=3              # days past due before the sweep defaults a loan
# LENDING_PENDING_EXPIRY_DAYS=7             # days before a trust loan awaiting collateral is cancelled
# Automatic payouts: pool loans at or under this USD amount pay out to the agent from a
# server-held payout wallet without an admin. Unset = off. Keep only a small float in it,
# topped up from the multisig treasury; loans it can't cover fall back to the admin queue.
# LENDING_AUTO_DISBURSE_MAX_USD=500
# LENDING_AUTO_DISBURSE_DAILY_USD=5000      # total auto-paid per UTC day (default 10x the per-loan max)
# LENDING_PAYOUT_SOLANA_SECRET_KEY=         # USDC + SOL pools; base58 or JSON byte array
# LENDING_PAYOUT_ETH_PRIVATE_KEY=           # ETH pool; 0x hex
# The hourly sweep (netlify/functions/lending-sweep.mts → POST /api/cron/lending-sweep)
# authenticates with INTERNAL_SERVICE_SECRET.

# ── Vault (agents use API keys without seeing them — /vault, /api/v1/bindings) ──
# Set ONE of these. Each secret gets its own data key, wrapped by:
#   VAULT_KMS_KEY    — a Google Cloud KMS key (recommended for production; use an HSM
#                      protection-level key for hardware-backed keys). Format:
#                      projects/<p>/locations/<l>/keyRings/<r>/cryptoKeys/<k>
#                      The Firebase Admin service account needs roles/cloudkms.cryptoKeyEncrypterDecrypter on it.
#   VAULT_MASTER_KEY — 32 random bytes, base64 (dev / self-hosting): openssl rand -base64 32
# Secrets written under one provider stay readable only while that provider is still configured.
# VAULT_KMS_KEY=
# VAULT_MASTER_KEY=
# VAULT_ALLOW_INSECURE_EGRESS=1             # dev only: lets bindings hit http:// and private IPs (ignored in production)

# ── Wallet intents (agents ask the hub to sign; see /vault → Wallets) ──
# Testnets only unless this is set AND a wallet's policy allows mainnet.
# INTENTS_ALLOW_MAINNET=1

# ── Agent identity tokens ("Sign in with Agent Guild" for agents) ──
# ES256 private key (PKCS#8 PEM; \n-escaped is fine). Public half is served at /.well-known/jwks.json.
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# AGENT_IDENTITY_PRIVATE_KEY=
# AGENT_IDENTITY_PREVIOUS_PUBLIC_KEY=        # SPKI PEM of the previous key, during a rotation

# CoinMarketCap API key — Hyperliquid mod market context (optional)
CMC_API_KEY=

# ─── Agent anti-sybil (lib/agent-standing.ts, agent-bond.ts, human-verification.ts) ───
# Refundable USDC bond per ASN, required to leave the provisional tier. 0 disables.
NEXT_PUBLIC_AGENT_BOND_USD=25
# Proof of Human for org owners (verified owners get a larger agent quota).
# Default is devnet; set the mainnet base URL + API key for production.
POH_BASE_URL=https://proofofhuman.ge/devnet
POH_API_KEY=
