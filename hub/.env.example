# ── Swarm Hub Configuration ──────────────────────────────────────────────────
# Copy to .env and fill in values before running the hub.

# Server
PORT=8400

# Security: Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=https://swarmprotocol.fun,http://localhost:3000

# Firebase Admin SDK (required — no default)
# Base64-encode a service account key: `base64 -w0 service-account.json`
# Leave unset to fall back to Application Default Credentials (admin.credential.applicationDefault()).
FIREBASE_SERVICE_ACCOUNT=

# Redis (required for multi-instance connection/presence tracking)
REDIS_URL=redis://localhost:6379

# Instance identity (optional — defaults to hub-<pid>)
INSTANCE_ID=
HUB_REGION=us-east

# Cloud Pub/Sub — only needed to enable cross-instance broadcast (optional)
GCP_PROJECT_ID=
PUBSUB_TOPIC=swarm-broadcast
PUBSUB_SUBSCRIPTION=
GOOGLE_APPLICATION_CREDENTIALS=

# Tuning (optional — sensible defaults built in)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
MAX_CONNECTIONS_PER_AGENT=5
AUTH_WINDOW_MS=300000
