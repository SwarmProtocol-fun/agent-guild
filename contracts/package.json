{
  "name": "swarm-contracts-link",
  "version": "1.0.0",
  "description": "Swarm Protocol smart contracts for Chainlink/LINK on Ethereum Sepolia",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
