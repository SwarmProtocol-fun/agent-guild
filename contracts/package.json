    "smoke:sepolia": "hardhat run scripts/smoke.ts --network sepolia",
    "smoke:hyperliquid": "hardhat run scripts/smoke.ts --network hyperliquidTestnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.1.0",
    "dotenv": "^16.4.7",
    "hardhat": "^2.22.0"
  }
}
