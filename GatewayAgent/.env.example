# ── Agent Guild GatewayAgent — Worker Configuration ─────────────────────────
# Copy to .env and fill in values, or set these directly in your host/PaaS
# (e.g. Railway's service Variables tab — gateway.mjs reads process.env
# directly, there's no dotenv loading).

# ── Registration (required) ─────────────────────────────────────────────────
HUB_URL=https://api.agent-guild.com
ORG_ID=
GATEWAY_WORKER_NAME=
# Service secret for hub auth. Omit to self-register with an Ed25519 keypair
# instead (see `gateway-agent register --help`).
INTERNAL_SERVICE_SECRET=

# ── Registration (optional) ─────────────────────────────────────────────────
GATEWAY_REGION=
GATEWAY_MAX_CONCURRENT=4
GATEWAY_POLL_INTERVAL_SEC=10
GATEWAY_DRAIN_TIMEOUT_SEC=60

# Comma-separated task types this worker can run. For a worker that ONLY
# trades on Hyperliquid, "shell,node,hyperliquid" is enough — "docker" isn't
# needed since the hyperliquid task type runs place_order.py as a direct
# subprocess, not a nested container (see scripts/executors/hyperliquid.mjs).
GATEWAY_RUNTIMES=shell,node,hyperliquid

# Comma-separated capability tags. The hyperliquid-trading mod enqueues
# every trade with resources.requiredTags: ["hyperliquid"] — a worker without
# this tag will never be assigned those tasks even if "hyperliquid" is also
# listed in GATEWAY_RUNTIMES above.
GATEWAY_TAGS=hyperliquid

# ── Hyperliquid trading (local testing fallback only) ───────────────────────
# There is NO shared worker-level trading key in production — every trade
# task carries its own agent's key in payload.privateKey, decrypted
# server-side per-request by the hyperliquid-trading mod from that agent's
# own encrypted wallet (POST /wallet) and never persisted (see
# scripts/executors/hyperliquid.mjs and AgentGuildApp's hyperliquid-store.ts
# for the zero-knowledge design). These two vars only matter if you're
# testing this worker directly with `gateway-agent run hyperliquid '{...}'`
# and skipping the mod entirely.
# HYPERLIQUID_PRIVATE_KEY=
# HYPERLIQUID_NETWORK=testnet

# ── Hyperliquid trading (optional overrides) ────────────────────────────────
# Path to place_order.py, if not using the bundled
# docker/hyperliquid/place_order.py (e.g. a custom build layout).
# HYPERLIQUID_SCRIPT_PATH=
# Python interpreter to invoke it with, if not the default on PATH.
# HYPERLIQUID_PYTHON_BIN=python3
