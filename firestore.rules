rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Org membership helper ───────────────────────────────────────────
    // Used by every per-org collection below. A caller is a member of
    // orgId if they are the org's owner or appear in its members array —
    // resolved by reading the actual organizations/{orgId} doc, never
    // from data the caller submitted in the same request (see the
    // organizations/{orgId} update rule fix below for why that matters).
    function isOrgMember(orgId) {
      return orgId != null &&
        exists(/databases/$(database)/documents/organizations/$(orgId)) &&
        (request.auth.uid == get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerAddress ||
         request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)).data.members);
    }

    // ── Auth model ──────────────────────────────────────────────────────
    // Login is wallet/SIWE (Thirdweb) verified server-side, then the server
    // mints a Firebase custom token (uid = canonical wallet address: lowercased
    // EVM hex, exact-case Solana base58 — see wallet-address.ts) so
    // the client SDK gets a real `request.auth`. Server-side privileged
    // writes go through the Firebase Admin SDK (src/lib/firebase-admin.ts,
    // src/lib/firestore-admin.ts), which bypasses these rules entirely.
    //
    // Every collection below was audited by tracing, for each one, every
    // file in the codebase that touches it and whether that file is
    // reachable from a browser bundle (a 'use client' component, directly
    // or transitively — including through dynamic `import()`, which a
    // plain grep for importers misses). Collections with zero remaining
    // client-reachable code path are denied outright below or by the final
    // catch-all; collections a dashboard page or component genuinely needs
    // are explicitly allowed to authenticated users.

    // Server-only — Admin SDK writes these, clients never touch them directly.
    match /sessions/{document=**}        { allow read, write: if false; }
    match /rateLimits/{document=**}      { allow read, write: if false; }
    match /platformSessions/{document=**} { allow read, write: if false; }
    match /userProfiles/{document=**}    { allow read, write: if false; }
    // agent-guild join --code <CODE>: created by /api/v1/agent-invites (Admin
    // SDK, requireOrgAdmin), resolved by /api/v1/invite/:code (Admin SDK,
    // public). No client-SDK path needs either read or write access.
    match /agentInvites/{document=**}    { allow read, write: if false; }

    // Explicit deny — sensitive/financial/security-critical, no client
    // access at all regardless of auth state. (creditPolicyLog and
    // githubEvents still have a client-SDK call site reaching for them —
    // src/lib/credit-policy-settings.ts's recordPolicyEvent, and the
    // useGitHubEvents hook — but both are write-audit / unused-feature
    // paths respectively; loosening either isn't worth the risk these
    // rules exist to avoid. recordPolicyEvent already fails open (it
    // wraps its write in try/catch), and no code anywhere currently writes
    // to githubEvents, so neither is a live regression.)
    match /secrets/{document=**}               { allow read, write: if false; }
    match /creditWebhooks/{document=**}         { allow read, write: if false; }
    match /subscriptions/{document=**}          { allow read, write: if false; }
    match /validationStakes/{document=**}       { allow read, write: if false; }
    match /slashingEvents/{document=**}         { allow read, write: if false; }
    // Job audit trail — append-only, written by the Admin SDK (lib/job-audit.ts),
    // read through GET /api/jobs/:jobId/events. No client access at all.
    match /jobEvents/{document=**}              { allow read, write: if false; }
    match /riskSignals/{document=**}            { allow read, write: if false; }
    match /fraudReviewQueue/{document=**}       { allow read, write: if false; }
    match /platformConnections/{document=**}    { allow read, write: if false; }
    match /marketplaceTransactions/{document=**} { allow read, write: if false; }
    // Solana job receipts. Written by the solana-settlement mod (Admin SDK)
    // and read back by that mod's history/verify routes. A browser must not
    // list another org's payouts.
    match /solanaSettlements/{document=**}      { allow read, write: if false; }
    match /solanaSettlementKeys/{document=**}   { allow read, write: if false; }
    // One ciphertext, three wraps (protocol, agent, user). The hub serves
    // it only while those identity NFT copies are still with their holders.
    match /identityVault/{document=**}          { allow read, write: if false; }
    match /creditPolicyLog/{document=**}        { allow read, write: if false; }
    match /githubEvents/{document=**}           { allow read, write: if false; }

    // Usage records: the /usage dashboard reads these directly via the
    // client SDK (src/lib/usage.ts's getUsageRecords, which always queries
    // `where("orgId", "==", orgId)`), but writes now go through the Admin
    // SDK only (src/lib/firestore-admin.ts's logUsage, used by
    // /api/v1/usage) — so client writes can stay denied while reads work.
    // Scoped to the caller's own org, unlike every other collection in this
    // file — `request.auth != null` alone let any signed-in user read every
    // org's token-usage/cost data.
    match /usageRecords/{docId} {
      allow read: if request.auth != null && isOrgMember(resource.data.orgId);
      allow write: if false;
    }

    // Public system/health-check doc.
    match /system/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Organizations — real ownership scoping now that request.auth.uid is
    // a verified wallet address.
    match /organizations/{orgId} {
      allow read: if request.auth != null;
      // inviteCode is server-managed (orgInvites, via the Admin SDK): org docs
      // are readable by every signed-in wallet, so a code stored here could be
      // read by anyone, and a client-planted code would be honored by the
      // legacy-code migration in resolveOrgInviteCode.
      // The creator must be the owner and the only initial member — otherwise
      // anyone could create an org "owned" by, or listing, someone else's
      // wallet, planting it in that wallet's org list. The owner adds members
      // afterwards via update.
      allow create: if request.auth != null &&
        request.resource.data.ownerAddress == request.auth.uid &&
        request.resource.data.members is list &&
        request.resource.data.members.hasOnly([request.auth.uid]) &&
        !request.resource.data.keys().hasAny(['inviteCode']);
      // Owner or an EXISTING member can update — but only the owner may
      // touch `ownerAddress` or `members`. Membership is checked only
      // against the document already stored (resource.data) — never
      // against request.resource.data, the caller's own submitted content.
      // (Previously this also allowed `request.auth.uid in
      // request.resource.data.members`, which let any authenticated wallet
      // self-join any org simply by including its own address in the
      // members array it submitted. Fixed: that clause is removed.)
      //
      // Without the field restriction below, any existing non-owner member
      // could call updateDoc() directly (bypassing the app's own
      // addMemberToOrganization/removeMemberFromOrganization helpers,
      // which are UI-gated to the owner but not rule-gated) to overwrite
      // `ownerAddress` to themselves and wipe out `members` — a full org
      // takeover in one client-SDK write. Every other field (name,
      // description, logoUrl, website, socials, isPrivate, agentSlots,
      // GitHub App linkage, etc.) stays open to any member, matching
      // existing usage (settings page, agent-guild slot assignment).
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.ownerAddress ||
        (request.auth.uid in resource.data.members &&
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['ownerAddress', 'members']))
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['inviteCode']);
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.ownerAddress;
    }

    // ── Authenticated dashboard collections ───────────────────────────────
    // Every one of these is read and/or written directly from a browser
    // bundle (dashboard pages/components via src/lib/*.ts client-SDK
    // calls). All of the pages that touch them require a logged-in session
    // at the Next.js middleware level (see PROTECTED_PAGE_PREFIXES in
    // src/middleware.ts). Each collection below was traced to its actual
    // write paths and re-scoped per-org (or per-owner) rather than merely
    // requiring `request.auth != null` — see per-collection comments for
    // the field each one is scoped on. `create` is handled separately from
    // read/update/delete because `resource.data` does not exist yet on
    // create; `request.resource.data` (the caller's own submitted content)
    // is used there instead.

    // ── Category A: org-scoped via `orgId` ──────────────────────────────
    // Updates may not re-point `orgId`: membership is only checked against
    // the doc's current org, so without this a member could move a task,
    // approval or job into any other org (e.g. inject work into a
    // competitor's board).
    function orgIdUnchanged() {
      return request.resource.data.orgId == resource.data.orgId;
    }
    match /activityEvents/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    match /agentComms/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    match /agentInstalls/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    match /agentMemories/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    match /agentMessages/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    match /agentSessions/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    match /agentSkills/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    // Credit/trust/identity fields on an agent drive money decisions
    // (lending origination, credit limits, job trust gates — all read
    // server-side via Admin SDK). Clients may create an agent only with the
    // default scores and may never change these fields afterwards; only
    // server code (Admin SDK, bypasses rules) mutates them.
    // tasksCompleted / rating*: server-maintained from approved, rated jobs
    // (lib/jobs-admin.ts). tasksCompleted gates Job.minCompletedJobs, so an org
    // must not be able to inflate its own agents' counts or ratings.
    function agentProtectedFields() {
      return ['creditScore', 'trustScore', 'asn', 'apiKeyHash', 'apiKey',
              'restoredFromBackup', 'walletAddress', 'solanaAddress',
              'nftMintAddress', 'nftMintedAt', 'nftOwnerEvmAddress',
              'tasksCompleted', 'ratingSum', 'ratingCount', 'avgRating',
              // Identity + anti-sybil standing (register route, agent-bond.ts):
              // a key swap or a cleared provisional flag must go through the server.
              'publicKey', 'agentAddress', 'provisional', 'provisionalSince',
              'ownerWallet', 'keyBoundAt', 'bond', 'retiredAt',
              // Policy-tier inputs (credit-policy.ts resolvePolicyTier)
              'riskFlags', 'fraudRiskScore', 'verificationLevel', 'confidenceLevel'];
    }
    match /agents/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) &&
        request.resource.data.orgId == resource.data.orgId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(agentProtectedFields());
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId) &&
        request.resource.data.get('creditScore', 680) == 680 &&
        request.resource.data.get('trustScore', 50) == 50 &&
        // Every browser-reserved agent starts provisional, clocked by the server.
        request.resource.data.get('provisional', false) == true &&
        request.resource.data.get('provisionalSince', null) == request.time &&
        !request.resource.data.keys().hasAny(['restoredFromBackup', 'walletAddress', 'solanaAddress',
                                              'nftMintAddress', 'nftMintedAt', 'nftOwnerEvmAddress',
                                              'tasksCompleted', 'ratingSum', 'ratingCount', 'avgRating',
                                              'publicKey', 'agentAddress', 'ownerWallet', 'keyBoundAt',
                                              'bond', 'retiredAt', 'riskFlags', 'fraudRiskScore',
                                              'verificationLevel', 'confidenceLevel']);
    }
    match /approvals/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    match /assignmentNotifications/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    match /channels/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    match /coordinators/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    match /cronJobs/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    match /gateways/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    match /installedSkills/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    // Applications are created, revised and accepted/rejected server-side only
    // (/api/jobs/:jobId/applications, /hire, /api/v1/jobs/:jobId/apply), so a
    // bidder can't mark its own bid accepted.
    match /jobApplications/{docId} {
      allow read: if request.auth != null && isOrgMember(resource.data.orgId);
      allow create, update, delete: if false;
    }
    match /jobComments/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    // Server-only job fields:
    //  - upfrontVerified*: set only by server-side on-chain payment verification
    //    (src/lib/solana/gig-payment-verify.ts) — a buyer must not be able to
    //    mark their own gig order as paid.
    //  - delivery / review / cancel / taskId: set only by the /api/jobs and
    //    /api/v1/jobs routes (lib/jobs-admin.ts), which validate the transition
    //    and write the audit trail. A client writing them directly could approve
    //    work without a record, or forge a delivery for an agent.
    function jobServerOnlyFields() {
      return ['upfrontVerifiedAt', 'upfrontVerifiedLamports',
              'deliveryNotes', 'deliveryFiles', 'deliveryHistory', 'completedByAgentName',
              'reviewStatus', 'reviewNotes', 'reviewedBy', 'reviewedAt', 'reviewHistory',
              'cancelledAt', 'cancelledBy', 'cancelReason', 'taskId', 'postedByAgentId',
              'collaboratorAgentIds', 'reviewWindowDays', 'reviewDueAt', 'reviewReminderSentAt',
              'reviewOverdueAt', 'autoApproved', 'rating', 'ratingComment', 'ratedBy', 'ratedAt'];
    }
    // All job state changes go through the server (/api/jobs/*, /api/v1/jobs/*,
    // /api/admin/jobs/*), which validates each transition, verifies on-chain
    // escrow signatures and writes the jobEvents audit trail. The browser
    // reads jobs and creates one thing directly: a gig order (orderGig), which
    // must start in_progress with escrow, if any, merely "funded".
    match /jobs/{docId} {
      // Gig orders live in the buyer's org but the seller org fulfils them,
      // so it may read them too (getIncomingGigOrders queries by
      // sellerOrgId). Seller writes go through /api/jobs/:jobId/deliver.
      allow read: if request.auth != null && (isOrgMember(resource.data.orgId) ||
        isOrgMember(resource.data.get('sellerOrgId', null)));
      allow update, delete: if false;
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId) &&
        request.resource.data.get('gigId', null) is string &&
        request.resource.data.status == 'in_progress' &&
        request.resource.data.get('escrow', {'status': 'funded'}).status == 'funded' &&
        !request.resource.data.keys().hasAny(jobServerOnlyFields());
    }
    match /kanbanBoards/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    match /kanbanTasks/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    match /leases/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    match /marketSubscriptions/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    match /modInstallations/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    match /operators/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    match /projects/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    match /reports/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    match /systemVitals/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    match /taskAssignments/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }
    match /tasks/{docId} {
      allow read, delete: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update: if request.auth != null && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow create: if request.auth != null && isOrgMember(request.resource.data.orgId);
    }

    // messages: no reliable `orgId` on every doc (src/lib/firestore.ts's
    // Message type has it as optional and it isn't consistently queried
    // on) — but every message always has `channelId`, and channels/{id}
    // is itself orgId-scoped above. Scope messages transitively through
    // their parent channel instead of trusting a possibly-absent field.
    match /messages/{docId} {
      allow read, delete: if request.auth != null &&
        exists(/databases/$(database)/documents/channels/$(resource.data.channelId)) &&
        isOrgMember(get(/databases/$(database)/documents/channels/$(resource.data.channelId)).data.orgId);
      // Who sent it and what it says are fixed at create. An agent DM runs
      // shell for its org owner's messages (v1/messages `fromOwner`), so a
      // member must not be able to rewrite one, or relabel their own as it.
      allow update: if request.auth != null &&
        exists(/databases/$(database)/documents/channels/$(resource.data.channelId)) &&
        isOrgMember(get(/databases/$(database)/documents/channels/$(resource.data.channelId)).data.orgId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['senderId', 'senderAddress', 'senderType', 'channelId', 'content', 'text']);
      // A human message is sent as the signed-in wallet, never as someone
      // else's. auth.uid is the canonical address: lowercased for EVM (so a
      // checksummed senderId matches via lower()), exact for case-sensitive
      // Solana base58 (matches via ==).
      allow create: if request.auth != null &&
        exists(/databases/$(database)/documents/channels/$(request.resource.data.channelId)) &&
        isOrgMember(get(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.orgId) &&
        (request.resource.data.get('senderType', '') != 'human' ||
          string(request.resource.data.get('senderId', '')) == request.auth.uid ||
          string(request.resource.data.get('senderId', '')).lower() == request.auth.uid);
    }

    // ── Category B: owner-scoped, not org-scoped ────────────────────────
    // profiles/{walletAddress}: doc ID is always the lowercased wallet
    // address (src/lib/firestore.ts's getProfile/setProfile), with a
    // matching `walletAddress` field. Reads stay broad — display names /
    // avatars are looked up across orgs (e.g. src/lib/firestore.ts's
    // getProfilesByAddresses) to render member names in shared channels —
    // but only the profile's own owner may write it.
    match /profiles/{walletAddress} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == walletAddress;
    }

    // ── Category C: genuinely shared/cross-org by design ────────────────
    // marketplaceAgents: public marketplace listings (src/lib/skills.ts's
    // getMarketplaceAgents queries status == "approved" with no org
    // filter — meant to be browsed by any org). Writable only by the
    // publishing creator (`authorWallet`).
    match /marketplaceAgents/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorWallet == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorWallet == request.auth.uid;
    }
    // communityMarketItems: same pattern (src/lib/skills.ts's
    // getCommunityItems / submitMarketItem) — public community listings,
    // writable only by their submitter (`submittedBy`).
    match /communityMarketItems/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.submittedBy == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.submittedBy == request.auth.uid;
    }
    // agentRatings / communityItemRatings: reviews of a shared marketplace
    // item, queried and displayed by packageId/itemId across every org
    // (e.g. src/components/market/persona-detail-dialog.tsx), so reads
    // must stay broad. Each rating does carry an `orgId`, but the true
    // authorship field is the reviewer's own wallet (`reviewerWallet`),
    // which is what write access is scoped to.
    match /agentRatings/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.reviewerWallet == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.reviewerWallet == request.auth.uid;
    }
    match /communityItemRatings/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.reviewerWallet == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.reviewerWallet == request.auth.uid;
    }
    // gigs: Fiverr-style listings, browsable across every org
    // (src/lib/firestore.ts's getActiveGigs has no org filter by design).
    // Writable by the listing org for its own fields, but two mutations are
    // made by the *buyer's* org instead, on a gig it doesn't own: orderGig()
    // bumps orderCount when placing an order, and addGigReview() rolls a
    // new rating into avgRating/ratingCount. Both are scoped narrowly by
    // affectedKeys() so a buyer can only touch those specific counters, not
    // rewrite the listing itself — and further constrained to a strict +1
    // step (matching what orderGig's increment(1) / addGigReview's
    // prevCount+1 actually write), so a non-owning, non-buying caller can't
    // set either counter to an arbitrary value to inflate their own listing
    // or sabotage a competitor's. avgRating is additionally bounded to the
    // 0-5 rating scale (src/lib/firestore.ts's GigReview.rating).
    match /gigs/{docId} {
      allow read: if request.auth != null;
      // A person-sold gig (sellerType "person") must name the lister's own
      // wallet as seller, and can't use on-chain escrow — escrow delivery is
      // signed by an agent key (see /api/jobs/:jobId/deliver).
      allow create: if request.auth != null && isOrgMember(request.resource.data.agentOrgId) &&
        (request.resource.data.get('sellerType', 'agent') != 'person' ||
         (request.resource.data.get('sellerAddress', '') == request.auth.uid &&
          request.resource.data.get('escrowEnabled', false) != true)) &&
        request.resource.data.get('orderCount', 0) == 0 &&
        request.resource.data.get('avgRating', 0) == 0 &&
        request.resource.data.get('ratingCount', 0) == 0;
      // Rating counters are written only by POST /api/v1/gigs/:gigId/reviews
      // (Admin SDK), which verifies the reviewer bought and approved the
      // order. Previously any signed-in wallet could bump ratingCount and set
      // avgRating to any 0–5 value (tanking a competitor in one write), and
      // the listing's own org could rewrite all three counters freely.
      allow update: if request.auth != null && (
        (isOrgMember(resource.data.agentOrgId) &&
         request.resource.data.agentOrgId == resource.data.agentOrgId &&
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['avgRating', 'ratingCount', 'orderCount', 'sellerType', 'sellerAddress']) &&
         (resource.data.get('sellerType', 'agent') != 'person' ||
          request.resource.data.get('escrowEnabled', false) != true)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderCount', 'updatedAt']) &&
         request.resource.data.orderCount == resource.data.orderCount + 1)
      );
      allow delete: if request.auth != null && isOrgMember(resource.data.agentOrgId);
    }
    // gigReviews: one per completed order, read broadly so any org can see
    // a gig's reviews (getGigReviews).
    // Writes go through POST /api/v1/gigs/:gigId/reviews only (see above).
    match /gigReviews/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // nodes: no orgId or any other org/owner field on the AgentGuildNode
    // type (src/lib/firestore.ts), and no write call site — client SDK or
    // Admin SDK — exists anywhere in this repo; only getAgentGuildNodes /
    // getAgentGuildNode (both reads) touch this collection. Compute-provider
    // nodes are presumably registered by an external provider process
    // outside this codebase, which would use the Admin SDK (bypasses these
    // rules) once that integration exists — until then there's no
    // legitimate client write path, so writes are denied rather than left
    // open to any authenticated user.
    match /nodes/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Everything else has been audited and has zero remaining client-SDK
    // call site reachable from a browser bundle — every server path that
    // touches these now goes through the Admin SDK (src/lib/firestore-admin.ts
    // and the fully-migrated lib files), which bypasses these rules
    // entirely. Denying by default here (rather than leaving this open) is
    // also what keeps any new collection safe automatically: it has to be
    // added above, explicitly, before a browser can touch it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
